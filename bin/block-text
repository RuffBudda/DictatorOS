#!/usr/bin/env python3
"""Render text in the Omarchy logo's block-letter style.

  block-text "YOUR NAME" > file.txt

Letters are drawn after /usr/share/omarchy/logo.txt (8 rows, ███ strokes,
▄/▀ half-block corners). Supported: A B C H I J K M O R S T U Y and space.
"""
import sys

G = {
"A": ["  ▄███████", " ███   ███", " ███   ███", "▄███▄▄▄███", "▀███▀▀▀███", " ███   ███", " ███   ███", " ███   █▀ "],
"B": [" ▄███████▄", " ███   ███", " ███   ███", "▄███▄▄▄██▀", "▀███▀▀▀██▄", " ███   ███", " ███   ███", "▄████████▀"],
"C": ["  ▄███████", " ███   ███", " ███   █▀ ", " ███      ", " ███      ", " ███   █▄ ", " ███   ███", " ███████▀ "],
"H": ["  ▄█   █▄  ", " ███   ███ ", " ███   ███ ", "▄███▄▄▄███▄", "▀███▀▀▀███ ", " ███   ███ ", " ███   ███ ", " ███   █▀  "],
"I": [" ▄█▄", " ███", " ███", " ███", " ███", " ███", " ███", " ▀█▀"],
"J": ["      ▄█▄", "      ███", "      ███", "      ███", "      ███", " ▄█   ███", " ███  ███", "  ▀████▀ "],
"K": ["  ▄█   ▄█▄", " ███   ███", " ███  ▄██▀", "▄█████▀▀  ", "▀█████▄▄  ", " ███  ▀██▄", " ███   ███", " ███   █▀ "],
"M": ["  ▄███████████▄", " ███   ███   ███", " ███   ███   ███", " ███   ███   ███", " ███   ███   ███", " ███   ███   ███", " ███   ███   ███", "  ▀█   ███   █▀ "],
"O": [" ▄█████▄ ", "███   ███", "███   ███", "███   ███", "███   ███", "███   ███", "███   ███", " ▀█████▀ "],
"R": ["  ▄███████", " ███   ███", " ███   ███", "▄███▄▄▄██▀", "▀███▀▀▀▀  ", "██████████", " ███   ███", " ███   █▀ "],
"S": ["  ▄███████", " ███   ███", " ███   █▀ ", " ▀███▄▄▄▄ ", "   ▀▀▀▀███", " ▄██   ███", " ███   ███", "  ▀█████▀ "],
"T": ["▄█████████▄", "    ███    ", "    ███    ", "    ███    ", "    ███    ", "    ███    ", "    ███    ", "    ▀█▀    "],
"U": ["  ▄█   █▄ ", " ███   ███", " ███   ███", " ███   ███", " ███   ███", " ███   ███", " ███   ███", "  ▀█████▀ "],
"Y": ["  ▄█   █▄ ", " ███   ███", " ███   ███", " ███▄▄▄███", " ▀▀▀▀▀▀███", " ▄██   ███", " ███   ███", "  ▀█████▀ "],
" ": ["    "] * 8,
}

def render(text):
    rows = [""] * 8
    for ch in text.upper():
        g = G.get(ch)
        if g is None:
            sys.exit(f"block-text: no glyph for {ch!r}")
        w = max(len(r) for r in g)
        for i in range(8):
            rows[i] += g[i].ljust(w) + " "
    return "\n".join(r.rstrip() for r in rows)

print(render(" ".join(sys.argv[1:]) or "OMARCHY"))
