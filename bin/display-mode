#!/bin/bash
# SUPER+P: Windows-style "Project" menu.
# Writes a Hyprland monitor override to $XDG_RUNTIME_DIR (cleared on reboot,
# so a bad choice never survives a restart) and reloads Hyprland.

MODE_FILE="${XDG_RUNTIME_DIR:-/run/user/$UID}/display-mode.lua"

all=$(hyprctl monitors all -j)
internal=$(jq -r '[.[] | select(.name | test("^(eDP|LVDS|DSI)-"))][0].name // empty' <<<"$all")
mapfile -t externals < <(jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-") | not).name' <<<"$all")

choice=$(omarchy-menu-select "Project" \
  $'󰌢\tPC screen only' \
  $'󰍺\tDuplicate' \
  $'󰍹\tExtend' \
  $'󰶐\tSecond screen only' \
  $'󰐾\tCast to a wireless display…\tMiracast TV, projector or dongle' \
  $'󰍹\tDisplay settings…\tArrange, scale and rotate screens') || exit 0

if [[ $choice == Display\ settings* ]]; then
  exec "$HOME/dotfiles/bin/display-settings"
fi

# Same as SUPER+N (bin/cast): Miracast / Chromecast picker in this menu style.
# Firewall rules for the Wi-Fi Direct link live in system/install.sh (6b).
if [[ $choice == Cast* ]]; then
  exec "$HOME/dotfiles/bin/cast"
fi

if [[ $choice != "PC screen only" && $choice != "Extend" ]] && (( ${#externals[@]} == 0 )); then
  omarchy-notification-send -g 󰍹 "No second screen connected"
  exit 1
fi

# Don't fight Omarchy's own mirror/disable toggles.
omarchy-hyprland-toggle internal-monitor-mirror off >/dev/null 2>&1
omarchy-hyprland-toggle internal-monitor-disable off >/dev/null 2>&1

: >"$MODE_FILE"
case "$choice" in
  "PC screen only")
    for e in "${externals[@]}"; do
      printf 'hl.monitor({ output = "%s", disabled = true })\n' "$e" >>"$MODE_FILE"
    done ;;
  "Duplicate")
    for e in "${externals[@]}"; do
      printf 'hl.monitor({ output = "%s", mode = "preferred", position = "auto", scale = "auto", mirror = "%s" })\n' "$e" "$internal" >>"$MODE_FILE"
    done ;;
  "Second screen only")
    # Checked again on every reload: turn the laptop panel off only while an
    # external screen is connected or the lid is shut. A plain "disabled = true"
    # fought Omarchy's "no screen left" recovery when an HDMI switcher pointed
    # away: the panel flickered on and off every ~2 s and the workspaces moved
    # around. ~/dotfiles/omarchy-overrides/bin/omarchy-hyprland-monitor-clamshell
    # reloads when the screen comes back. The marker line below is how it finds
    # this mode.
    [[ -n $internal ]] && cat >>"$MODE_FILE" <<EOF
-- display-mode: second-screen-only $internal
do
  local bin = (os.getenv("OMARCHY_PATH") or "/usr/share/omarchy") .. "/bin/"
  local p = io.popen(bin .. "omarchy-hw-external-monitors || " .. bin .. "omarchy-hw-laptop-closed && echo yes")
  local away = p and p:read("a") or ""
  if p then p:close() end
  if away:find("yes") then
    hl.monitor({ output = "$internal", disabled = true })
  end
end
EOF
    ;;
  "Extend") ;;
esac

hyprctl reload >/dev/null
omarchy-notification-send -g 󰍹 "Display: $choice"
