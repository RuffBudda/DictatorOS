{
  "version": 1,
  "idle": {
    "screensaver": 0,
    "lock": 0
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "abu.workspaces"
        },
        {
          "id": "abu.stickynotes"
        }
      ],
      "center": [
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "abu.openvpn"
        },
        {
          "id": "abu.printjobs"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "abu.monitor"
        },
        {
          "id": "abu.power",
          "showPercentage": true
        }
      ],
      "centerBegin": [],
      "centerEnd": [],
      "tray": []
    },
    "id": "abu.bar"
  },
  "plugins": [
    {
      "id": "abu.notifications"
    },
    {
      "id": "abu.alttab"
    },
    {
      "id": "abu.lock"
    },
    {
      "id": "abu.desktop-osd"
    },
    {
      "id": "abu.workspaces"
    },
    {
      "id": "abu.openvpn"
    },
    {
      "id": "abu.stickynotes"
    },
    {
      "id": "abu.github-graph"
    },
    {
      "id": "ruffbudda.whoop"
    },
    {
      "id": "abu.wallpaper-fade"
    }
  ],
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.lock",
    "omarchy.weather",
    "almorus.workspace-apps",
    "rmarchei.openvpn",
    "rasp.power",
    "omarchy.background"
  ],
  "cloneSourceRestores": [
    "abu.notifications",
    "abu.lock"
  ]
}
