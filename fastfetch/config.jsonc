// DictatorOS fastfetch config (based on Omarchy's /etc/fastfetch/config.jsonc).
// Red keys, DictatorOS name, parody logo in ~/dotfiles/fastfetch/logo.txt.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/dotfiles/fastfetch/logo.txt",
    "color": { "1": "red" },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "disableLinewrap": true
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "red"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "red"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "format": "{name}",
      "keyColor": "red"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "red"
    },
    {
      "type": "swap",
      "key": "└ └󰓡",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "command",
      "key": "󰆥 OS",
      "keyColor": "red",
      "text": "version=$(omarchy-version) && echo \"DictatorOS (Omarchy $version)\""
    },
    {
      "type": "command",
      "key": "│ ├󰘬",
      "keyColor": "red",
      "text": "omarchy-version-branch"
    },
    {
      "type": "command",
      "key": "│ ├󰔫",
      "keyColor": "red",
      "text": "channel=$(omarchy-version-channel); echo \"$channel\""
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "red"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "red"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "red"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "red"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "red"
    },
    {
      "type": "command",
      "key": "│ ├󰸌",
      "keyColor": "red",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\""
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Age / Uptime / Update───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "red",
      "text": "days=$(( ($(date +%s) - $(stat -c %W /var/log)) / 86400 )); omarchy-i18n --count \"$days\" about.days \"$days\""
    },
    {
      "type": "command",
      "key": "󱫐 Uptime",
      "keyColor": "red",
      "text": "up=$(cut -d. -f1 /proc/uptime); d=$((up / 86400)); h=$((up % 86400 / 3600)); m=$((up % 3600 / 60)); if [ \"$d\" -gt 0 ]; then omarchy-i18n agents.durationDaysHours \"$d\" \"$h\"; elif [ \"$h\" -gt 0 ]; then omarchy-i18n battery.durationHoursMinutes \"$h\" \"$m\"; else omarchy-i18n battery.durationMinutes \"$m\"; fi"
    },
    {
      "type": "command",
      "key": " Update",
      "keyColor": "red",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\""
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
